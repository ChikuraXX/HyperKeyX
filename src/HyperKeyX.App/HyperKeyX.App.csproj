<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>HyperKeyX</RootNamespace>
    <AssemblyName>HyperKeyX</AssemblyName>
    <Version>1.0.1</Version>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ChikuraXX/HyperKeyX</RepositoryUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\HyperKeyX.ico</ApplicationIcon>
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AppxPackage>false</AppxPackage>
    <!-- 发布依赖共享运行时；本地 Debug 保留现有开发启动方式。 -->
    <WindowsAppSDKSelfContained Condition="'$(Configuration)' == 'Debug'">true</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(Configuration)' != 'Debug'">false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE;..\..\COPYING;..\..\COPYING.LESSER"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\ThirdPartyNotices\CommunityToolkit.Windows.MIT.txt"
             Link="ThirdPartyNotices\CommunityToolkit.Windows.MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Assets\Brand\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Assets\Brand\HyperKeyX.ico" />
    <Content Remove="Assets\Brand\HyperKeyX.ico" />
    <Content Include="Assets\Brand\HyperKeyX.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 仅引用实际使用的组件，避免聚合包携带未使用的 AI/ML 原生运行库；版本与原聚合包一致。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperKeyX.Domain\HyperKeyX.Domain.csproj" />
    <ProjectReference Include="..\HyperKeyX.Application\HyperKeyX.Application.csproj" />
    <ProjectReference Include="..\HyperKeyX.Infrastructure\HyperKeyX.Infrastructure.csproj" />
  </ItemGroup>

  <!-- WinUI 非打包发布必须保留应用 PRI，否则界面资源无法解析，程序会在启动时退出。 -->
  <Target Name="IncludeApplicationPriInPublish" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
           Text="发布缺少 WinUI 应用资源索引：$(TargetDir)$(AssemblyName).pri" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri"
                             RelativePath="$(AssemblyName).pri"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
