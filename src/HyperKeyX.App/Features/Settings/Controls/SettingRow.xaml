<UserControl
    x:Class="HyperKeyX.Features.Settings.Controls.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RowLayout"
          MinHeight="{x:Bind ScaleMetrics.SettingsRowMinHeight, Mode=OneWay}"
          Padding="16,12"
          ColumnSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.Setters>
                        <Setter Target="ActionRow.Height" Value="0"/>
                        <Setter Target="ActionColumn.Width" Value="Auto"/>
                        <Setter Target="ActionPresenter.(Grid.Row)" Value="0"/>
                        <Setter Target="ActionPresenter.(Grid.Column)" Value="2"/>
                        <Setter Target="ActionPresenter.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="ActionPresenter.Margin" Value="0"/>
                        <Setter Target="ActionPresenter.HorizontalAlignment" Value="Right"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="ActionRow.Height" Value="Auto"/>
                        <Setter Target="ActionColumn.Width" Value="0"/>
                        <Setter Target="ActionPresenter.(Grid.Row)" Value="1"/>
                        <Setter Target="ActionPresenter.(Grid.Column)" Value="1"/>
                        <Setter Target="ActionPresenter.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="ActionPresenter.Margin" Value="0,8,0,0"/>
                        <Setter Target="ActionPresenter.HorizontalAlignment" Value="Left"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ActionColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="ActionRow" Height="0"/>
        </Grid.RowDefinitions>

        <FontIcon Grid.Column="0"
                  Glyph="{x:Bind Glyph, Mode=OneWay}"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="{x:Bind ScaleMetrics.IconGlyphSize, Mode=OneWay}"
                  Width="{x:Bind ScaleMetrics.SmallIconButtonSize, Mode=OneWay}"
                  VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1"
                    Spacing="2"
                    VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       FontSize="{x:Bind ScaleMetrics.BodyFontSize, Mode=OneWay}"
                       FontWeight="Normal"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                       FontSize="{x:Bind ScaleMetrics.CaptionFontSize, Mode=OneWay}"
                       Opacity="0.65"
                       TextWrapping="Wrap"/>
        </StackPanel>
        <ContentPresenter x:Name="ActionPresenter"
                          Grid.Column="2"
                          MaxWidth="{x:Bind ScaleMetrics.SettingsActionWidth, Mode=OneWay}"
                          HorizontalContentAlignment="Right"
                          Content="{x:Bind ActionContent, Mode=OneWay}"
                          VerticalAlignment="Center"/>
    </Grid>
</UserControl>
