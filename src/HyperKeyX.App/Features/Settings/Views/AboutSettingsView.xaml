<UserControl
    x:Name="TypographyRoot"
    x:Class="HyperKeyX.Features.Settings.Views.AboutSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HyperKeyX.Features.Settings.Controls">
    <UserControl.Resources>
        <Style x:Key="ProjectLinkStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="28">
        <StackPanel Spacing="16" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                <Image Width="64" Height="64" Source="ms-appx:///Assets/Brand/HyperKeyXLogo.png"
                       AutomationProperties.Name="HyperKeyX"/>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="HyperKeyX" FontSize="{x:Bind ViewModel.UiScaleMetrics.LargeTitleFontSize, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.VersionCaptionText, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SoftwareDescriptionText, Mode=OneWay}"
                       FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="CheckForUpdatesButton" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.CheckForUpdatesText, Mode=OneWay}" Click="OnCheckForUpdates">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="16" Height="16"
                                      IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                        <TextBlock FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.CheckForUpdatesText, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
                <Button FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="DownloadUpdateButton" Content="{x:Bind ViewModel.DownloadUpdateText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CanDownloadUpdate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        Click="OnDownloadUpdate"/>
                <Button Content="{x:Bind ViewModel.CancelUpdateDownloadText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        Click="OnCancelUpdateDownload"/>
                <Button Content="{x:Bind ViewModel.InstallUpdateText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CanInstallUpdate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        Click="OnInstallUpdate"/>
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.UpdateDownloadPercent, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                         AutomationProperties.Name="{x:Bind ViewModel.DownloadUpdateText, Mode=OneWay}"/>
            <TextBlock FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.HasUpdateStatus, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.UpdateSectionText, Mode=OneWay}"
                       FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Margin="0,0,0,4"/>
            <Border Style="{StaticResource SettingsRowContainerStyle}">
                <controls:SettingRow x:Name="AutomaticUpdatesRow"
                                     Title="{x:Bind ViewModel.AutomaticUpdatesText, Mode=OneWay}"
                                     Glyph="&#xE895;" ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                    <controls:SettingRow.ActionContent>
                        <ToggleSwitch Height="{x:Bind ViewModel.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}" FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="AutomaticUpdatesToggle"
                                      AutomationProperties.Name="{x:Bind ViewModel.AutomaticUpdatesText, Mode=OneWay}"
                                      OnContent="{x:Bind ViewModel.ToggleOnText, Mode=OneWay}"
                                      OffContent="{x:Bind ViewModel.ToggleOffText, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.AutomaticUpdatesEnabled, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.AreUpdateFeaturesEnabled, Mode=OneWay}"
                                      Toggled="OnAutomaticUpdatesToggled"/>
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>
            </Border>
            <Border Style="{StaticResource SettingsRowContainerStyle}">
                <controls:SettingRow x:Name="PreviewUpdatesRow"
                                     Title="{x:Bind ViewModel.PreviewUpdatesText, Mode=OneWay}"
                                     Glyph="&#xED56;" ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                    <controls:SettingRow.ActionContent>
                        <ToggleSwitch Height="{x:Bind ViewModel.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}" FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="PreviewUpdatesToggle"
                                      AutomationProperties.Name="{x:Bind ViewModel.PreviewUpdatesText, Mode=OneWay}"
                                      OnContent="{x:Bind ViewModel.ToggleOnText, Mode=OneWay}"
                                      OffContent="{x:Bind ViewModel.ToggleOffText, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.IncludePreviewUpdates, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}"
                                      Toggled="OnPreviewUpdatesToggled"/>
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>
            </Border>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.SupportSectionText, Mode=OneWay}"
                       FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Margin="0,0,0,4"/>
            <Button FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="OpenFeedbackButton" Style="{StaticResource ProjectLinkStyle}"
                    AutomationProperties.Name="{x:Bind ViewModel.ReportBugText, Mode=OneWay}" Click="OnOpenFeedback">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Glyph="&#xEBE8;" FontSize="{x:Bind ViewModel.UiScaleMetrics.HeadingFontSize, Mode=OneWay}" Width="{x:Bind ViewModel.UiScaleMetrics.SmallIconButtonSize, Mode=OneWay}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ReportBugText, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}"/>
                </Grid>
            </Button>
            <Button FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="OpenFeatureRequestButton" Style="{StaticResource ProjectLinkStyle}"
                    AutomationProperties.Name="{x:Bind ViewModel.FeatureRequestText, Mode=OneWay}" Click="OnOpenFeatureRequest">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Glyph="&#xEA80;" FontSize="{x:Bind ViewModel.UiScaleMetrics.HeadingFontSize, Mode=OneWay}" Width="{x:Bind ViewModel.UiScaleMetrics.SmallIconButtonSize, Mode=OneWay}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FeatureRequestText, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}"/>
                </Grid>
            </Button>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.OtherLinksText, Mode=OneWay}"
                       FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}"/>
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="40" Margin="-12,0,0,0">
                <HyperlinkButton x:Name="OpenRepositoryButton" Content="{x:Bind ViewModel.RepositoryText, Mode=OneWay}" Click="OnOpenRepository"/>
                <HyperlinkButton x:Name="OpenReleasesButton" Content="{x:Bind ViewModel.ReleaseHistoryText, Mode=OneWay}" Click="OnOpenReleases"/>
                <HyperlinkButton x:Name="OpenUsageGuideButton" Content="{x:Bind ViewModel.UsageGuideText, Mode=OneWay}" Click="OnOpenUsageGuide"/>
                <HyperlinkButton x:Name="OpenLicenseButton" Content="{x:Bind ViewModel.LicenseText, Mode=OneWay}" Click="OnOpenLicense"/>
            </VariableSizedWrapGrid>
        </StackPanel>
    </StackPanel>
</UserControl>
