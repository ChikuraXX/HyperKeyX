<UserControl
    x:Name="TypographyRoot"
    x:Class="HyperKeyX.Features.Settings.Views.AppearanceSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HyperKeyX.Features.Settings.Controls">
    <StackPanel Spacing="8">
        <Border Style="{StaticResource SettingsRowContainerStyle}">
            <controls:SettingRow Title="{x:Bind ViewModel.LanguageText, Mode=OneWay}"
                                 Description="{x:Bind ViewModel.LanguageDescriptionText, Mode=OneWay}"
                                 Glyph="&#xE775;"
                                 ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                <controls:SettingRow.ActionContent>
                    <ComboBox FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" MaxWidth="{x:Bind ViewModel.UiScaleMetrics.SettingsActionWidth, Mode=OneWay}" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"/>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </Border>

        <Border Style="{StaticResource SettingsRowContainerStyle}">
            <controls:SettingRow Title="{x:Bind ViewModel.ThemeText, Mode=OneWay}"
                                 Description="{x:Bind ViewModel.ThemeDescriptionText, Mode=OneWay}"
                                 Glyph="&#xE790;"
                                 ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                <controls:SettingRow.ActionContent>
                    <ComboBox FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" MaxWidth="{x:Bind ViewModel.UiScaleMetrics.SettingsActionWidth, Mode=OneWay}" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"/>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </Border>

        <Border Style="{StaticResource SettingsRowContainerStyle}">
            <controls:SettingRow Title="{x:Bind ViewModel.FontText, Mode=OneWay}"
                                 Description="{x:Bind ViewModel.FontDescriptionText, Mode=OneWay}"
                                 Glyph="&#xE8D2;"
                                 ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                <controls:SettingRow.ActionContent>
                    <Button FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="ChooseFontButton"
                            MaxWidth="{x:Bind ViewModel.UiScaleMetrics.SettingsActionWidth, Mode=OneWay}" HorizontalAlignment="Stretch"
                            Content="{x:Bind ViewModel.SelectedFontFamilyName, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.FontText, Mode=OneWay}"
                            Click="OnChooseFont"/>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </Border>

        <Border Style="{StaticResource SettingsRowContainerStyle}">
            <controls:SettingRow Title="{x:Bind ViewModel.AccentText, Mode=OneWay}"
                                 Description="{x:Bind ViewModel.AccentDescriptionText, Mode=OneWay}"
                                 Glyph="&#xE2B1;"
                                 ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                <controls:SettingRow.ActionContent>
                    <Grid HorizontalAlignment="Right"
                          ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="8">
                        <ComboBox FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.AccentModeOptions, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedAccentModeIndex, Mode=TwoWay}"/>
                        <Button FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="AccentColorButton"
                                Grid.Column="1"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Width="{x:Bind ViewModel.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Height="{x:Bind ViewModel.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsCustomAccentActive, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ChooseAccentColorText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ChooseAccentColorText, Mode=OneWay}">
                            <Border x:Name="AccentSwatch"
                                    Width="18"
                                    Height="18"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"/>
                            <Button.Flyout>
                                <Flyout Opened="OnAccentFlyoutOpened">
                                    <ColorPicker x:Name="AccentColorPicker"
                                                 IsAlphaEnabled="False"
                                                 ColorChanged="OnAccentColorChanged"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </Border>

        <InfoBar Severity="Warning" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.IsAccentContrastWarningOpen, Mode=OneWay}"
                 Message="{x:Bind ViewModel.AccentContrastWarningText, Mode=OneWay}"/>

        <Border Style="{StaticResource SettingsRowContainerStyle}">
            <controls:SettingRow Title="{x:Bind ViewModel.BackdropText, Mode=OneWay}"
                                 Description="{x:Bind ViewModel.BackdropDescriptionText, Mode=OneWay}"
                                 Glyph="&#xE771;"
                                 ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                <controls:SettingRow.ActionContent>
                    <ComboBox FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" MaxWidth="{x:Bind ViewModel.UiScaleMetrics.SettingsActionWidth, Mode=OneWay}" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.BackdropOptions, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}"/>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </Border>

        <Border Style="{StaticResource SettingsRowContainerStyle}">
            <controls:SettingRow Title="{x:Bind ViewModel.UiScaleText, Mode=OneWay}"
                                 Description="{x:Bind ViewModel.UiScaleDescriptionText, Mode=OneWay}"
                                 Glyph="&#xE8A3;"
                                 ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                <controls:SettingRow.ActionContent>
                    <ComboBox FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" MaxWidth="{x:Bind ViewModel.UiScaleMetrics.SettingsActionWidth, Mode=OneWay}" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.UiScaleOptions, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedUiScaleIndex, Mode=TwoWay}"/>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </Border>

        <Border Style="{StaticResource SettingsRowContainerStyle}">
            <controls:SettingRow Title="{x:Bind ViewModel.CustomBackgroundText, Mode=OneWay}"
                                 Description="{x:Bind ViewModel.CustomBackgroundDescriptionText, Mode=OneWay}"
                                 Glyph="&#xE91B;"
                                 ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                <controls:SettingRow.ActionContent>
                    <Grid MaxWidth="{x:Bind ViewModel.UiScaleMetrics.SettingsActionWidth, Mode=OneWay}" HorizontalAlignment="Stretch"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <ToggleSwitch Height="{x:Bind ViewModel.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}" FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="CustomBackgroundToggle"
                                  AutomationProperties.Name="{x:Bind ViewModel.CustomBackgroundText, Mode=OneWay}"
                                  OnContent="{x:Bind ViewModel.ToggleOnText, Mode=OneWay}"
                                  OffContent="{x:Bind ViewModel.ToggleOffText, Mode=OneWay}"
                                      HorizontalAlignment="Right"
                                      IsOn="{x:Bind ViewModel.CustomBackgroundEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanEnableCustomBackground, Mode=OneWay}"/>
                        <Button FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="ChooseBackgroundButton"
                                Grid.Column="1"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Width="{x:Bind ViewModel.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Height="{x:Bind ViewModel.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Click="OnChooseBackground"
                                AutomationProperties.Name="{x:Bind ViewModel.ChooseBackgroundImageText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ChooseBackgroundImageText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8B7;"
                                      Style="{StaticResource CommandFontIconStyle}"
                                      FontSize="{x:Bind ViewModel.UiScaleMetrics.IconGlyphSize, Mode=OneWay}"/>
                        </Button>
                    </Grid>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </Border>

        <Border Style="{StaticResource SettingsRowContainerStyle}"
                Visibility="{x:Bind ViewModel.IsBackgroundOverlayOpacityVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <controls:SettingRow Title="{x:Bind ViewModel.BackgroundOverlayOpacityText, Mode=OneWay}"
                                 Description="{x:Bind ViewModel.BackgroundOverlayOpacityDescriptionText, Mode=OneWay}"
                                 Glyph="&#xE706;"
                                 ScaleMetrics="{x:Bind ViewModel.UiScaleMetrics, Mode=OneWay}">
                <controls:SettingRow.ActionContent>
                    <Grid MaxWidth="{x:Bind ViewModel.UiScaleMetrics.SettingsActionWidth, Mode=OneWay}" HorizontalAlignment="Stretch"
                          Width="{x:Bind ViewModel.UiScaleMetrics.SettingsActionWidth, Mode=OneWay}"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Slider x:Name="BackgroundOpacitySlider"
                                Minimum="0.65"
                                Maximum="1"
                                StepFrequency="0.01"
                                Value="{x:Bind ViewModel.BackgroundOverlayOpacity, Mode=TwoWay}"
                                PointerCaptureLost="OnOpacityInteractionCompleted"
                                LostFocus="OnOpacityLostFocus"
                                KeyUp="OnOpacitySliderKeyUp"/>
                        <TextBlock FontSize="{x:Bind ViewModel.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="1"
                                   Text="{x:Bind ViewModel.BackgroundOverlayOpacityPercentText, Mode=OneWay}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </Border>
    </StackPanel>
</UserControl>
