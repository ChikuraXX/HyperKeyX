<Page
    x:Name="TypographyRoot"
    x:Class="HyperKeyX.Features.Profiles.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="using:HyperKeyX.Shell.Appearance">


    <ScrollViewer x:Name="ProfilesScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled"
                  HorizontalContentAlignment="Stretch"
                  ZoomMode="Disabled">
        <Grid MaxWidth="1360"
              Margin="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardPageMargin, Mode=OneWay}"
              HorizontalAlignment="Stretch"
              RowDefinitions="Auto,*"
              RowSpacing="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionSpacing, Mode=OneWay}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{x:Bind ViewModel.ProfilesText, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.PageTitleFontSize, Mode=OneWay}"
                               FontWeight="Normal"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentProcessDisplayText, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                               Opacity="0.65"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="1"
                        Content="{x:Bind ViewModel.ImportText, Mode=OneWay}"
                        Click="OnImportProfiles"
                        VerticalAlignment="Center"/>
                <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="2"
                        Content="{x:Bind ViewModel.ExportText, Mode=OneWay}"
                        Click="OnExportProfiles"
                        VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="ProfilesWorkspace" SizeChanged="OnSizeChanged"
                  Grid.Row="1"
                  ColumnSpacing="28"
                  RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ProfileListColumn" Width="*"/>
                    <ColumnDefinition x:Name="ProfileDetailsColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="ProfileDetailsRow" Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="ProfileListPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsEnabled="{x:Bind ViewModel.CanEditProfileWorkspace, Mode=OneWay}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.ProfilesText, Mode=OneWay}"
                                   FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"/>
                        <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="1"
                                Width="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Click="OnAddProfile"
                                AutomationProperties.Name="{x:Bind ViewModel.AddProfileTooltipText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.AddProfileTooltipText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE710;"
                                      FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}"
                                      Style="{StaticResource CommandFontIconStyle}"/>
                        </Button>
                        <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="2"
                                Width="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Click="OnDeleteProfile"
                                IsEnabled="{x:Bind ViewModel.CanDeleteSelectedProfile, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.DeleteProfileTooltipText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.DeleteProfileTooltipText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE74D;"
                                      FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}"
                                      Style="{StaticResource CommandFontIconStyle}"/>
                        </Button>
                    </Grid>

                    <ListView x:Name="ProfileList" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                              SelectionMode="Single"
                              MinHeight="180"
                              MaxHeight="480"
                              FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="{Binding ElementName=TypographyRoot, Path=ViewModel.Settings.UiScaleMetrics.SelectionItemMinHeight}">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="{Binding ElementName=TypographyRoot, Path=ViewModel.Settings.UiScaleMetrics.BodyFontSize}"
                                           FontWeight="Normal" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <ReorderThemeTransition/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    </ListView>
                </Grid>
                </ContentControl>

                <ContentControl x:Name="ProfileDetailsPanel"
                                motion:ContentMotion.Context="{x:Bind ViewModel.SelectedProfile, Mode=OneWay}"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsEnabled="{x:Bind ViewModel.CanEditTriggerConfiguration, Mode=OneWay}"
                                Padding="28,0,0,0"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1,0,0,0"
                                HorizontalContentAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch"
                                Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ProfileDetailsText, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.HeadingFontSize, Mode=OneWay}"
                                       FontWeight="Normal"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedProfileDisplayName, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CompactBodyFontSize, Mode=OneWay}"
                                       Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Height="1"
                                Background="{ThemeResource SystemControlForegroundBaseLowBrush}"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.TargetText, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}"
                                       FontWeight="Normal"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="0"
                                          x:Name="ProcessComboBox"
                                          ItemsSource="{x:Bind ViewModel.ProcessNames, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedProcessName, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.CanEditTargetProcess, Mode=OneWay}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="{x:Bind ViewModel.ProcessPlaceholderText, Mode=OneWay}"/>
                                <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="1"
                                        Width="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                        Height="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                        Style="{StaticResource CompactIconButtonStyle}"
                                        Command="{x:Bind ViewModel.RefreshProcessesCommand}"
                                        AutomationProperties.Name="{x:Bind ViewModel.RefreshText, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.RefreshText, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE72C;"
                                              FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}"
                                              Style="{StaticResource CommandFontIconStyle}"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CurrentProcessDisplayText, Mode=OneWay}"
                                       FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
