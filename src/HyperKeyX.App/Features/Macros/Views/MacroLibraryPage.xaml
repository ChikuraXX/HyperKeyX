<Page
    x:Class="HyperKeyX.Features.Macros.Views.MacroLibraryPage"
    x:Name="MacroPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="using:HyperKeyX.Shell.Appearance"
    xmlns:vm="using:HyperKeyX.Features.Macros.ViewModels"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnPageSizeChanged">

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="MacroLibraryLayoutStates">
            <VisualState x:Name="MacroLibraryWideLayout"/>
            <VisualState x:Name="MacroLibraryListLayout"/>
            <VisualState x:Name="MacroLibraryDetailLayout"/>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid Background="Transparent">
        <ContentDialog x:Name="DeleteMacroDialog"
                       Title="{x:Bind ViewModel.DeleteMacroTitleText, Mode=OneWay}"
                       PrimaryButtonText="{x:Bind ViewModel.DeleteText, Mode=OneWay}"
                       CloseButtonText="{x:Bind ViewModel.CancelText, Mode=OneWay}"
                       DefaultButton="Close">
            <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.DeleteMacroConfirmationText, Mode=OneWay}"
                       TextWrapping="Wrap"/>
        </ContentDialog>

        <Grid Padding="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardPageMargin, Mode=OneWay}"
              RowDefinitions="Auto,*"
              RowSpacing="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionSpacing, Mode=OneWay}">
            <Grid Grid.Row="0"
                  MinHeight="52"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="0,0,0,1">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.MacroLibraryTitleText, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.LargeIconGlyphSize, Mode=OneWay}"
                               FontWeight="Normal"/>
                    <TextBlock Text="{x:Bind ViewModel.MacroLibrarySubtitleText, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                               Opacity="0.65"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                           Opacity="0.7"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="MacroLibraryWorkspace" SizeChanged="OnPageSizeChanged"
                  Grid.Row="1"
                  MinHeight="0"
                  ColumnDefinitions="Auto,12,*">
                <Grid x:Name="MacroListHost"
                      Grid.Column="0"
                      Width="{x:Bind ViewModel.Settings.UiScaleMetrics.MacroLibraryListWidth, Mode=OneWay}"
                      MinWidth="240"
                      RowDefinitions="Auto,*"
                      RowSpacing="10">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <AutoSuggestBox x:Name="MacroSearchBox"
                                        Grid.Column="0"
                                        Text="{x:Bind ViewModel.MacroLibrary.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{x:Bind ViewModel.CanEditTriggerConfiguration, Mode=OneWay}"
                                        PlaceholderText="{x:Bind ViewModel.MacroSearchPlaceholderText, Mode=OneWay}"
                                        QueryIcon="Find"
                                        AutomationProperties.Name="{x:Bind ViewModel.MacroSearchPlaceholderText, Mode=OneWay}"/>
                        <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="1"
                                Width="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Command="{x:Bind ViewModel.CreateMacroCommand}"
                                IsEnabled="{x:Bind ViewModel.CanEditTriggerConfiguration, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.CreateMacroText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CreateMacroText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE710;"
                                      FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionFontSize, Mode=OneWay}"
                                      Style="{StaticResource CommandFontIconStyle}"/>
                        </Button>
                        <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="2"
                                Width="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Command="{x:Bind ImportMacroCommand}"
                                IsEnabled="{x:Bind ViewModel.CanEditTriggerConfiguration, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ImportMacroText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ImportMacroText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8B5;"
                                      FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionFontSize, Mode=OneWay}"
                                      Style="{StaticResource CommandFontIconStyle}"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" MinHeight="0">
                        <ListView x:Name="MacroList"
                                  ItemsSource="{x:Bind ViewModel.MacroLibrary.FilteredMacros, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.MacroLibrary.SelectedMacro, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditTriggerConfiguration, Mode=OneWay}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnMacroSelectionChanged">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <ReorderThemeTransition/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="MinHeight" Value="68"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MacroDefinitionViewModel">
                                    <Grid Padding="8,6"
                                          ColumnDefinitions="32,*,Auto"
                                          ColumnSpacing="10">
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE8D4;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.SectionFontSize}"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.BodyFontSize}" Text="{x:Bind Name, Mode=OneWay}"
                                                       FontWeight="Normal"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8FD;"
                                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                              FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.SmallCaptionFontSize}"/>
                                                    <TextBlock Text="{x:Bind StepCount, Mode=OneWay}"
                                                               FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.SmallCaptionFontSize}"
                                                               Opacity="0.7"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE71B;"
                                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                              FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.SmallCaptionFontSize}"/>
                                                    <TextBlock Text="{x:Bind ReferenceCount, Mode=OneWay}"
                                                               FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.SmallCaptionFontSize}"
                                                               Opacity="0.7"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="5"
                                                    VerticalAlignment="Center">
                                            <FontIcon FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.IconGlyphSize}" Glyph="&#xE73E;"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Visibility="{x:Bind IsDirty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind DirtyStatusText, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{x:Bind DirtyStatusText, Mode=OneWay}"/>
                                            <FontIcon FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.IconGlyphSize}" Glyph="&#xEA39;"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                      Visibility="{x:Bind HasValidationErrors, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind ValidationStatusText, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{x:Bind ValidationStatusText, Mode=OneWay}"/>
                                            <FontIcon FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.IconGlyphSize}" Glyph="&#xE74D;"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                      Visibility="{x:Bind IsDeleted, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind DeletionStatusText, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{x:Bind DeletionStatusText, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="MacroListEmptyState"
                                   Text="{x:Bind ViewModel.NoMacroSelectedText, Mode=OneWay}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.65"
                                   MaxWidth="220"/>
                    </Grid>
                </Grid>

                <Grid x:Name="MacroDetailHost"
                      motion:ContentMotion.Context="{x:Bind ViewModel.MacroLibrary.SelectedMacro, Mode=OneWay}"
                      Grid.Column="2"
                      MinWidth="{x:Bind ViewModel.Settings.UiScaleMetrics.MacroLibraryDetailMinWidth, Mode=OneWay}"
                      RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <Grid Grid.Row="0"
                          MinHeight="40"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8">
                        <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="BackToMacroListButton"
                                Grid.Column="0"
                                Width="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Click="OnBackToMacroList"
                                IsEnabled="{x:Bind ViewModel.CanEditTriggerConfiguration, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.BackToMacroListText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BackToMacroListText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE72B;"
                                      FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionFontSize, Mode=OneWay}"
                                      Style="{StaticResource CommandFontIconStyle}"/>
                        </Button>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.MacroLibrary.SelectedMacro.Name, Mode=OneWay}"
                                   FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionFontSize, Mode=OneWay}"
                                   FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                            <Button x:Name="MacroReferencesButton" Grid.Column="1" FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.MacroReferencesText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.MacroReferencesText, Mode=OneWay}"/>
                                    <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="("/>
                                    <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.MacroLibrary.SelectedMacroReferences.Count, Mode=OneWay}"/>
                                    <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text=")"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="MacroReferencesFlyout" Placement="Bottom" Opened="OnReferencesOpened">
                                        <Grid MinWidth="260" MaxWidth="420" RowDefinitions="Auto,Auto" RowSpacing="8">
                                            <ListView x:Name="MacroReferenceList"
                                                      Grid.Row="0"
                                                      MaxHeight="240"
                                                      ItemsSource="{x:Bind ViewModel.MacroLibrary.SelectedMacroReferences, Mode=OneWay}"
                                                      SelectionMode="None">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MacroReferenceViewModel">
                                                        <Button FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.BodyFontSize}" Click="OnOpenMacroReferenceCommand"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                AutomationProperties.Name="{x:Bind TriggerDisplayName}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <TextBlock FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.BodyFontSize}" Text="{x:Bind ProfileName}"
                                                                               FontWeight="Normal"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{x:Bind TriggerDisplayName}"
                                                                               FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.CaptionFontSize}"
                                                                               Opacity="0.7"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <FontIcon FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.IconGlyphSize}" Grid.Column="1"
                                                                          Glyph="&#xE72A;"
                                                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                          VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="NoMacroReferencesTextBlock"
                                                       Grid.Row="1"
                                                       Text="{x:Bind ViewModel.NoMacroReferencesText, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.65"/>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <CommandBar Grid.Column="2"
                                    DefaultLabelPosition="Collapsed"
                                    IsOpen="False"
                                    Background="Transparent">
                            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCurrentMacroCommand}"
                                          IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"
                                          Label="{x:Bind ViewModel.SaveMacroText, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SaveMacroText, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind ViewModel.SaveMacroText, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE74E;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Command="{x:Bind ViewModel.RestoreCurrentMacroCommand}"
                                          IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"
                                          Label="{x:Bind ViewModel.RestoreCurrentMacroText, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.RestoreCurrentMacroText, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind ViewModel.RestoreCurrentMacroText, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE72C;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Command="{x:Bind ViewModel.CopyCurrentMacroCommand}"
                                          IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"
                                          Label="{x:Bind ViewModel.CopyMacroText, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.CopyMacroText, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind ViewModel.CopyMacroText, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Command="{x:Bind ExportCurrentMacroCommand}"
                                          IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"
                                          Label="{x:Bind ViewModel.ExportMacroText, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.ExportMacroText, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind ViewModel.ExportMacroText, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE898;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Command="{x:Bind DeleteCurrentMacroCommand}"
                                          IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"
                                          Label="{x:Bind ViewModel.DeleteMacroText, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.DeleteMacroText, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind ViewModel.DeleteMacroText, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>

                    <Grid Grid.Row="1" MinHeight="0">
                        <ScrollViewer x:Name="MacroDetailScrollViewer"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Auto"
                                      ZoomMode="Disabled">
                            <Grid x:Name="DetailEditorContent"
                                  RowDefinitions="Auto,Auto,Auto,Auto,*"
                                  RowSpacing="14">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="14">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.MacroNameText, Mode=OneWay}"/>
                                        <TextBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.MacroLibrary.SelectedMacro.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="100"
                                                 IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"/>
                                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.MacroLibrary.SelectedMacro.NameValidationText, Mode=OneWay}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind ViewModel.MacroLibrary.SelectedMacro.HasValidationErrors, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.MacroDescriptionText, Mode=OneWay}"/>
                                        <TextBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.MacroLibrary.SelectedMacro.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{x:Bind ViewModel.MacroDescriptionPlaceholderText, Mode=OneWay}"
                                                 MaxLength="500"
                                                 IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"/>
                                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.MacroLibrary.SelectedMacro.DescriptionValidationText, Mode=OneWay}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="Auto,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10">
                                    <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="0"
                                            Width="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                            Height="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            IsEnabled="{x:Bind ViewModel.CanToggleRecording, Mode=OneWay}"
                                            Click="OnToggleRecording"
                                            AutomationProperties.Name="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind ViewModel.RecordIconGlyph, Mode=OneWay}"
                                                  FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionFontSize, Mode=OneWay}"
                                                  Style="{StaticResource CommandFontIconStyle}"/>
                                    </Button>
                                    <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="1"
                                               Text="{x:Bind ViewModel.RecordingIndicatorText, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               FontWeight="Normal"/>
                                    <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="{x:Bind ViewModel.RecordingOptionsText, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0"
                                              IsEnabled="{x:Bind ViewModel.CanEditRecordingOptions, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <ComboBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Header="{x:Bind ViewModel.RecordingKindText, Mode=OneWay}"
                                                      ItemsSource="{x:Bind ViewModel.RecordingKindOptions, Mode=OneWay}"
                                                      SelectedIndex="{x:Bind ViewModel.RecordingKindIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                            <ComboBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Header="{x:Bind ViewModel.RecordingCoordinatesText, Mode=OneWay}"
                                                      ItemsSource="{x:Bind ViewModel.RecordingCoordinateOptions, Mode=OneWay}"
                                                      SelectedIndex="{x:Bind ViewModel.RecordingCoordinateModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{x:Bind ViewModel.RecordingUsesPath, Mode=OneWay}"/>
                                            <ComboBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Header="{x:Bind ViewModel.RecordingTargetText, Mode=OneWay}"
                                                      ItemsSource="{x:Bind ViewModel.RecordingTargets, Mode=OneWay}" DisplayMemberPath="Name"
                                                      SelectedIndex="{x:Bind ViewModel.RecordingTargetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{x:Bind ViewModel.RecordingUsesWindow, Mode=OneWay}"/>
                                            <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.PathRecordingHelp, Mode=OneWay}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Expander>
                                </Grid>



                                <StackPanel x:Name="BlockingReferencesPanel"
                                            Grid.Row="3"
                                            Spacing="8">
                                    <InfoBar IsOpen="True"
                                             Severity="Warning"
                                             Message="{x:Bind ViewModel.BlockedMacroDeletionText, Mode=OneWay}"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.MacroLibrary.BlockingReferences, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MacroReferenceViewModel">
                                                <TextBlock FontSize="{Binding ElementName=MacroPageRoot, Path=ViewModel.Settings.UiScaleMetrics.BodyFontSize}" Text="{x:Bind TriggerDisplayName}"
                                                           Margin="8,2"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ContentControl x:Name="MacroEditorHost"
                                                Grid.Row="4"
                                                Margin="0,8,0,0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"/>
                            </Grid>
                        </ScrollViewer>

                        <Grid x:Name="NoMacroSelectedPanel">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <FontIcon Glyph="&#xE8D4;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.DisplayIconGlyphSize, Mode=OneWay}"
                                          Opacity="0.55"/>
                                <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.NoMacroSelectedText, Mode=OneWay}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
