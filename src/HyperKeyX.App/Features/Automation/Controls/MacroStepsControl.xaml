<UserControl
    x:Class="HyperKeyX.Features.Automation.Controls.MacroStepsControl"
    x:Name="EditorRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HyperKeyX.Features.Automation.ViewModels"
    xmlns:controls="using:HyperKeyX.Features.Automation.Controls"
    IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnEditorSizeChanged">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator"/>
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoAccelerator"/>
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator"/>
        <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="OnDuplicateAccelerator"/>
        <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnMoveUpAccelerator"/>
        <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="OnMoveDownAccelerator"/>
    </UserControl.KeyboardAccelerators>

    <ContentControl x:Name="MacroPanel"
                    Grid.Column="0"
                    MinHeight="360"
                    Padding="0"
                    IsEnabled="{x:Bind ViewModel.CanEditSelectedMacro, Mode=OneWay}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0"
              MinHeight="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}"
              ColumnDefinitions="*">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.MacroStepsText, Mode=OneWay}"
                           FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.SubtitleFontSize, Mode=OneWay}"
                           FontWeight="Normal"/>
            </StackPanel>
        </Grid>

        <CommandBar Grid.Row="1"
                    DefaultLabelPosition="Collapsed"
                    IsOpen="False"
                    Background="Transparent">
            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Label="{x:Bind ViewModel.SelectedMacroEditor.AddText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.AddText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.AddText, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.AddPathText, Mode=OneWay}" Click="OnAddMousePath"/>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.AddKeyboardClickText, Mode=OneWay}"
                                            Click="OnAddKeyboardClick"/>
                        <MenuFlyoutSubItem Text="{x:Bind ViewModel.SelectedMacroEditor.AddMouseClickText, Mode=OneWay}">
                            <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.LeftMouseButtonText, Mode=OneWay}" Tag="Left" Click="OnAddMouseClick"/>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.RightMouseButtonText, Mode=OneWay}" Tag="Right" Click="OnAddMouseClick"/>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MiddleMouseButtonText, Mode=OneWay}" Tag="Middle" Click="OnAddMouseClick"/>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MouseButton4Text, Mode=OneWay}" Tag="XButton1" Click="OnAddMouseClick"/>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MouseButton5Text, Mode=OneWay}" Tag="XButton2" Click="OnAddMouseClick"/>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.AddDelayText, Mode=OneWay}" Click="OnAddDelay"/>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.WheelUpText, Mode=OneWay}" Click="OnAddWheelUp"/>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.WheelDownText, Mode=OneWay}" Click="OnAddWheelDown"/>
                        <MenuFlyoutSubItem Text="{x:Bind ViewModel.SelectedMacroEditor.AdvancedText, Mode=OneWay}">
                            <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.KeyboardDownText, Mode=OneWay}" Click="OnAddKeyboardDown"/>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.KeyboardUpText, Mode=OneWay}" Click="OnAddKeyboardUp"/>
                            <MenuFlyoutSubItem Text="{x:Bind ViewModel.SelectedMacroEditor.MouseDownText, Mode=OneWay}">
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.LeftMouseButtonText, Mode=OneWay}" Tag="Left" Click="OnAddMouseDown"/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.RightMouseButtonText, Mode=OneWay}" Tag="Right" Click="OnAddMouseDown"/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MiddleMouseButtonText, Mode=OneWay}" Tag="Middle" Click="OnAddMouseDown"/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MouseButton4Text, Mode=OneWay}" Tag="XButton1" Click="OnAddMouseDown"/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MouseButton5Text, Mode=OneWay}" Tag="XButton2" Click="OnAddMouseDown"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="{x:Bind ViewModel.SelectedMacroEditor.MouseUpText, Mode=OneWay}">
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.LeftMouseButtonText, Mode=OneWay}" Tag="Left" Click="OnAddMouseUp"/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.RightMouseButtonText, Mode=OneWay}" Tag="Right" Click="OnAddMouseUp"/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MiddleMouseButtonText, Mode=OneWay}" Tag="Middle" Click="OnAddMouseUp"/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MouseButton4Text, Mode=OneWay}" Tag="XButton1" Click="OnAddMouseUp"/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMacroEditor.MouseButton5Text, Mode=OneWay}" Tag="XButton2" Click="OnAddMouseUp"/>
                            </MenuFlyoutSubItem>
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarSeparator/>

            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Click="OnUndo"
                          IsEnabled="{x:Bind ViewModel.SelectedMacroEditor.CanUndo, Mode=OneWay}"
                          Label="{x:Bind ViewModel.SelectedMacroEditor.UndoText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.UndoText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.UndoText, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE7A7;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Click="OnRedo"
                          IsEnabled="{x:Bind ViewModel.SelectedMacroEditor.CanRedo, Mode=OneWay}"
                          Label="{x:Bind ViewModel.SelectedMacroEditor.RedoText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.RedoText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.RedoText, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE7A6;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Click="OnMoveUp"
                          IsEnabled="{x:Bind ViewModel.SelectedMacroEditor.CanMoveUp, Mode=OneWay}"
                          Label="{x:Bind ViewModel.SelectedMacroEditor.MoveUpText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.MoveUpText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.MoveUpText, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE74A;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Click="OnMoveDown"
                          IsEnabled="{x:Bind ViewModel.SelectedMacroEditor.CanMoveDown, Mode=OneWay}"
                          Label="{x:Bind ViewModel.SelectedMacroEditor.MoveDownText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.MoveDownText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.MoveDownText, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE74B;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Click="OnDuplicate"
                          IsEnabled="{x:Bind ViewModel.SelectedMacroEditor.CanEditSelection, Mode=OneWay}"
                          Label="{x:Bind ViewModel.SelectedMacroEditor.DuplicateText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.DuplicateText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.DuplicateText, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Click="OnDelete"
                          IsEnabled="{x:Bind ViewModel.SelectedMacroEditor.CanEditSelection, Mode=OneWay}"
                          Label="{x:Bind ViewModel.SelectedMacroEditor.DeleteText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.DeleteText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.DeleteText, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Click="OnClear"
                          Label="{x:Bind ViewModel.SelectedMacroEditor.ClearText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.ClearText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.ClearText, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE894;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Click="OnRestoreSaved"
                          Label="{x:Bind ViewModel.SelectedMacroEditor.RestoreSavedText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.RestoreSavedText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.RestoreSavedText, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xE72C;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid x:Name="EditorBody"
              Grid.Row="2"
              MinHeight="260"
              ColumnDefinitions="*,12,Auto">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="EditorLayoutStates">
                    <VisualState x:Name="WideEditorState"/>
                    <VisualState x:Name="CompactEditorState"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="MacroListHost"
                  Grid.Column="0"
                  MinWidth="0"
                  BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1">
                <ListView x:Name="MacroStepList"
                          ItemsSource="{x:Bind ViewModel.SelectedMacroEditor.Steps, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedMacroEditor.SelectedStep, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnStepSelectionChanged">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <ReorderThemeTransition/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MacroStepEditorViewModel">
                            <Grid MinHeight="{Binding ElementName=EditorRoot, Path=ViewModel.Settings.UiScaleMetrics.MacroEditorRowMinHeight}"
                                  ColumnDefinitions="40,32,*,32"
                                  ColumnSpacing="8"
                                  Padding="8,2"
                                  AutomationProperties.Name="{x:Bind AccessibleText}">
                                <TextBlock FontSize="{Binding ElementName=EditorRoot, Path=ViewModel.Settings.UiScaleMetrics.BodyFontSize}" Grid.Column="0"
                                           Text="{x:Bind SequenceNumber, Mode=OneWay}"
                                           Opacity="0.6"
                                           VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="1"
                                          Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="{Binding ElementName=EditorRoot, Path=ViewModel.Settings.UiScaleMetrics.BodyFontSize}"
                                          VerticalAlignment="Center"/>
                                <TextBlock FontSize="{Binding ElementName=EditorRoot, Path=ViewModel.Settings.UiScaleMetrics.BodyFontSize}" Grid.Column="2"
                                           Text="{x:Bind DisplayText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <FontIcon FontSize="{Binding ElementName=EditorRoot, Path=ViewModel.Settings.UiScaleMetrics.IconGlyphSize}" Grid.Column="3"
                                          Glyph="&#xEA39;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          Visibility="{x:Bind HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}"
                                          AutomationProperties.Name="{x:Bind ValidationText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedMacroEditor.EmptyText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.SelectedMacroEditor.Steps.Count, Converter={StaticResource IntToVisibilityConverter}, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.6"/>
            </Grid>

            <Grid x:Name="PropertyPane"
                  Grid.Column="2"
                  Width="{x:Bind ViewModel.Settings.UiScaleMetrics.MacroEditorPropertyPaneWidth, Mode=OneWay}"
                  MinWidth="0"
                  Padding="16,8,0,8"
                  DataContext="{x:Bind ViewModel.SelectedMacroEditor.SelectedStep, Mode=OneWay}"
                  RowDefinitions="Auto,*">
                <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Row="0"
                           Text="{x:Bind ViewModel.SelectedMacroEditor.PropertiesText, Mode=OneWay}"
                           FontWeight="Normal"/>
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel
                            Spacing="10"
                            Margin="0,10,0,0">
                    <controls:MousePathEditorControl x:Name="PathDetails" Visibility="{Binding IsPathAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <StackPanel Visibility="{Binding IsKeyboardAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="6">
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedMacroEditor.KeyboardKeyText, Mode=OneWay}"/>
                        <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="ChooseKeyboardKeyButton"
                                Click="OnChooseSelectedKeyboardKey"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.ChooseKeyboardKeyText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.ChooseKeyboardKeyText, Mode=OneWay}">
                            <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{Binding DisplayText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsMouseButtonAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="6">
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedMacroEditor.MouseButtonText, Mode=OneWay}"/>
                        <ComboBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="MouseButtonValue"
                                  MinWidth="{x:Bind ViewModel.Settings.UiScaleMetrics.MacroNumericInputMinWidth, Mode=OneWay}"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnMouseButtonValueChanged"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsWheelAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="6">
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedMacroEditor.WheelDeltaText, Mode=OneWay}"/>
                        <NumberBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="WheelDeltaValue"
                                   Minimum="-1200"
                                   Maximum="1200"
                                   SmallChange="120"
                                   MinWidth="{x:Bind ViewModel.Settings.UiScaleMetrics.MacroNumericInputMinWidth, Mode=OneWay}"
                                   SpinButtonPlacementMode="Inline"
                                   GotFocus="OnNumericEditStarted"
                                   ValueChanged="OnWheelDeltaChanged"
                                   KeyDown="OnNumericEditKeyDown"
                                   LostFocus="OnNumericEditCompleted"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          Visibility="{Binding CanConfigureDelay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedMacroEditor.RandomDelayText, Mode=OneWay}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ToggleSwitch Height="{x:Bind ViewModel.Settings.UiScaleMetrics.StandardIconButtonSize, Mode=OneWay}" FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="RandomDelayToggle" Grid.Column="1"
                                      AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.RandomDelayText, Mode=OneWay}"
                                      Toggled="OnRandomDelayToggled"/>
                    </Grid>

                    <StackPanel Spacing="6" Visibility="{Binding IsRandomDelay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedMacroEditor.DelayDistributionText, Mode=OneWay}"/>
                        <ComboBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="RandomDelayDistributionValue"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.DelayDistributionText, Mode=OneWay}"
                                  SelectionChanged="OnRandomDelayDistributionChanged"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedMacroEditor.NormalDelayHint, Mode=OneWay}"
                                   FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}" Opacity="0.65" TextWrapping="Wrap"
                                   Visibility="{Binding IsNormalDelay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsDelayAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="6">
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{Binding DelayCaption}"/>
                        <NumberBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="DelayDurationValue"
                                   Minimum="0"
                                   Maximum="60000"
                                   SmallChange="10"
                                   MinWidth="{x:Bind ViewModel.Settings.UiScaleMetrics.MacroNumericInputMinWidth, Mode=OneWay}"
                                   SpinButtonPlacementMode="Inline"
                                   GotFocus="OnNumericEditStarted"
                                   ValueChanged="OnDelayDurationChanged"
                                   KeyDown="OnNumericEditKeyDown"
                                   LostFocus="OnNumericEditCompleted"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasPostActionDelay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="6">
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{Binding PostDelayCaption}"/>
                        <NumberBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="PostActionDelayValue"
                                   Minimum="0"
                                   Maximum="60000"
                                   SmallChange="10"
                                   MinWidth="{x:Bind ViewModel.Settings.UiScaleMetrics.MacroNumericInputMinWidth, Mode=OneWay}"
                                   SpinButtonPlacementMode="Inline"
                                   GotFocus="OnNumericEditStarted"
                                   ValueChanged="OnPostActionDelayChanged"
                                   KeyDown="OnNumericEditKeyDown"
                                   LostFocus="OnNumericEditCompleted"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRandomDelay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="6">
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedMacroEditor.MaximumDelayText, Mode=OneWay}"/>
                        <NumberBox FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" x:Name="RandomDelayMaximumValue"
                                   AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.MaximumDelayText, Mode=OneWay}"
                                   Minimum="0" Maximum="60000" SmallChange="10"
                                   MinWidth="{x:Bind ViewModel.Settings.UiScaleMetrics.MacroNumericInputMinWidth, Mode=OneWay}"
                                   SpinButtonPlacementMode="Inline"
                                   GotFocus="OnNumericEditStarted" ValueChanged="OnRandomDelayMaximumChanged"
                                   KeyDown="OnNumericEditKeyDown" LostFocus="OnNumericEditCompleted"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Glyph="&#xEA39;"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{Binding ValidationText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,8,0,0"
                    Spacing="6">
            <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedMacroEditor.HistoryTrimmedText, Mode=OneWay}" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  Visibility="{x:Bind ViewModel.SelectedMacroEditor.HasValidationErrors, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <FontIcon FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.IconGlyphSize, Mode=OneWay}" Grid.Column="0"
                          Glyph="&#xEA39;"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                <TextBlock FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="1"
                           Text="{x:Bind ViewModel.SelectedMacroEditor.ValidationSummaryText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="2"
                        Content="{x:Bind ViewModel.SelectedMacroEditor.FocusFirstErrorText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.SelectedMacroEditor.CanFocusFirstError, Mode=OneWay}"
                        Click="OnFocusFirstError"
                        AutomationProperties.Name="{x:Bind ViewModel.SelectedMacroEditor.FocusFirstErrorText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SelectedMacroEditor.FocusFirstErrorText, Mode=OneWay}"/>
            </Grid>
            <InfoBar IsOpen="{x:Bind ViewModel.SelectedMacroEditor.HasCommandError, Mode=OneWay}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.SelectedMacroEditor.CommandErrorText, Mode=OneWay}"/>
        </StackPanel>
        </Grid>
    </ContentControl>
</UserControl>
