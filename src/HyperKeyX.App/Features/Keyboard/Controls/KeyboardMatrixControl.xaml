<UserControl
    x:Class="HyperKeyX.Features.Keyboard.Controls.KeyboardMatrixControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

                    <ScrollViewer x:Name="KeyboardMatrixScrollViewer"
                          Grid.Row="0"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          HorizontalContentAlignment="Stretch"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          ZoomMode="Disabled">
                <ContentControl x:Name="KeyboardMatrixInteractionBoundary"
                                IsEnabled="{x:Bind ViewModel.CanEditTriggerConfiguration, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                <Viewbox x:Name="KeyboardMatrixViewbox"
                         MaxWidth="{x:Bind ViewModel.Settings.UiScaleMetrics.KeyboardCanvasWidth, Mode=OneWay}"
                         HorizontalAlignment="Stretch"
                         Stretch="Uniform">
                    <Grid Width="920">
                        <!-- ===== 108 键全尺寸虚拟键盘 ===== -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="580, 30, 120, 30, 160"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="6"
                          HorizontalAlignment="Center">

                        <Grid.Resources>
                            <Style x:Key="BaseKeyStyle" TargetType="Button">
                                <Setter Property="Height" Value="38"/>
                                <Setter Property="FontFamily" Value="{StaticResource HyperKeyXKeycapFontFamily}"/>
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                                <Setter Property="FocusVisualMargin" Value="-2"/>
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="Root">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="InteractionOverlay.Opacity" Value="0.08"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="InteractionOverlay.Opacity" Value="0.14"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <VisualState.Setters>
                                                                <Setter Target="Root.Opacity" Value="0.45"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <!-- 状态底色始终保留；悬浮只叠加反馈层，不能覆盖连发或宏的高亮色。 -->
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="{TemplateBinding CornerRadius}"/>
                                                <Border x:Name="InteractionOverlay"
                                                        Background="{ThemeResource TextFillColorPrimaryBrush}"
                                                        CornerRadius="{TemplateBinding CornerRadius}"
                                                        IsHitTestVisible="False"
                                                        Opacity="0"/>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                  Foreground="{TemplateBinding Foreground}"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="KeyStyle" TargetType="Button" BasedOn="{StaticResource BaseKeyStyle}">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                            <Style x:Key="StretchKeyStyle" TargetType="Button" BasedOn="{StaticResource BaseKeyStyle}">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                            <Style x:Key="ControlKeyStyle" TargetType="Button" BasedOn="{StaticResource BaseKeyStyle}">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                            <Style x:Key="NumpadKeyStyle" TargetType="Button" BasedOn="{StaticResource BaseKeyStyle}">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </Grid.Resources>

