<Page
    x:Name="TypographyRoot"
    x:Class="HyperKeyX.Features.Keyboard.Views.KeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HyperKeyX.Features.Keyboard.ViewModels">

    <Grid x:Name="KeyboardPageLayout"
          Padding="{x:Bind ViewModel.Settings.UiScaleMetrics.KeyboardPagePadding, Mode=OneWay}"
          RowDefinitions="Auto,*"
          RowSpacing="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionSpacing, Mode=OneWay}">
        <Grid Grid.Row="0"
              MinHeight="42"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              ColumnSpacing="12"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,0,1">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.KeyboardNavigationText, Mode=OneWay}"
                                   FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.HeadingFontSize, Mode=OneWay}"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"/>
                        <Button FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.BodyFontSize, Mode=OneWay}" Grid.Column="1"
                                Click="OnOpenProfiles"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind ViewModel.ProfilesText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ProfilesText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedProfileDisplayName, Mode=OneWay}"
                                           FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind ViewModel.ActiveRuntimeProfileDisplayText, Mode=OneWay}"
                                   FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                                   Opacity="0.75"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4"
                                   Text="{x:Bind ViewModel.CurrentProcessDisplayText, Mode=OneWay}"
                                   FontSize="{x:Bind ViewModel.Settings.UiScaleMetrics.CaptionFontSize, Mode=OneWay}"
                                   Opacity="0.65"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
        </Grid>

        <!-- 键盘页只选择触发器；宏步骤统一在独立宏库中编辑。 -->
        <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Row="1"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="KeyboardWorkspace"
              Grid.Row="1"
              MinHeight="0"
              ColumnDefinitions="*,Auto"
              RowDefinitions="*,0"
              SizeChanged="OnWorkspaceSizeChanged"
              RowSpacing="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionSpacing, Mode=OneWay}"
              ColumnSpacing="{x:Bind ViewModel.Settings.UiScaleMetrics.SectionSpacing, Mode=OneWay}">
            <ScrollViewer x:Name="KeyboardContentScrollViewer"
                          Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          ZoomMode="Disabled">
                <Grid RowDefinitions="Auto">
                    <ContentControl x:Name="KeyboardMatrixHost"
                                    Grid.Row="0"
                                    HorizontalContentAlignment="Stretch" />
                </Grid>
            </ScrollViewer>

            <ContentControl x:Name="TriggerInspectorHost"
                            Grid.Column="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
        </ScrollViewer>
    </Grid>

</Page>

