<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HyperKeyX.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:HyperKeyX.Common.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Shell/Appearance/ToggleSwitchStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 原生对话框和提示栏的标题也使用常规字重。 -->
            <FontWeight x:Key="InfoBarTitleFontWeight">Normal</FontWeight>
            <Style TargetType="ContentDialog">
                <Setter Property="TitleTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Normal" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 所有页面统一采用状态文字在左、轨道在右的紧凑原生开关。 -->
            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource RightAlignedCompactToggleSwitchStyle}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            <Color x:Key="HyperKeyXAccentColor">#FF0078D4</Color>
            <SolidColorBrush x:Key="HyperKeyXAccentBrush"
                             Color="{StaticResource HyperKeyXAccentColor}"/>
            <FontFamily x:Key="HyperKeyXKeycapFontFamily">Segoe UI</FontFamily>
            <Style x:Key="CompactIconButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
            <Style x:Key="CommandFontIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SettingsRowContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
